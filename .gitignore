# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 화면 캡처 원본 (파일명이 '스크린샷 …'인 것). 블러 처리 전 상태라
# 그대로 커밋되면 안 된다. 의미 있는 이름으로 바꾼 사본만 커밋한다.
public/images/**/스크린샷 *.png
public/images/**/화면 캡처 *.png
